# === Uygulama Sunucusu Yapılandırması ===
PORT=8080

# === Veritabanı Sunucusu Bağlantı Bilgileri ===
DB_HOST=db
DB_PORT=5432
DB_USER=bap
DB_PASSWORD=bap_admin_1
DB_NAME=bap_app

# === Veritabanı Bağlantı Havuzu Ayarları ===
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MIN=5

# === Güvenlik ===
JWT_SECRET=super-secret-key

# === LDAP Kimlik Doğrulama ===
LDAP_ENABLED=true
LDAP_MOCK=true
LDAP_HOST=localhost
LDAP_PORT=389
LDAP_BASE_DN=dc=izu,dc=edu,dc=tr
LDAP_BIND_DN=cn=admin,dc=izu,dc=edu,dc=tr
LDAP_BIND_PASSWORD=admin123
LDAP_USER_FILTER=(&(objectClass=person)(mail=%s))

# === Yapay Zeka (LLM) Yapılandırması ===
LLM_PROVIDER=ollama
LLM_ENDPOINT=http://apiyapayzeka.pve.izu.edu.tr
LLM_MODEL=qwen3:8b
GEMINI_API_KEY=