# ============================================
# BAP AI - Örnek Ortam Değişkenleri (.env.example)
# ============================================
# Bu dosyayı ".env" olarak kopyalayıp kendi değerlerinizle doldurun.
# Komut: cp .env.example .env

# === Uygulama Sunucusu Yapılandırması ===
# Uygulamanın çalışacağı port numarası
PORT=8080

# === Veritabanı Sunucusu Bağlantı Bilgileri ===
# DB_HOST: PostgreSQL'in kurulu olduğu sunucunun IP adresi veya hostname
#   - Docker ortamında genellikle 'db' (compose service adı) kullanılır
#   - Yerel geliştirmede 'localhost' kullanılır
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=bap_app

# === Veritabanı Bağlantı Havuzu Ayarları ===
# Uzak veritabanı sunucusu için performans optimizasyonu
# DB_MAX_OPEN_CONNS: Aynı anda açık tutulabilecek maksimum bağlantı sayısı
DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS: Boşta bekleyen maksimum bağlantı sayısı
DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME_MIN: Bir bağlantının yaşam süresi (dakika)
DB_CONN_MAX_LIFETIME_MIN=5

# === Güvenlik ===
# JWT_SECRET: Token imzalamak için kullanılan gizli anahtar
# ÖNEMLİ: Üretim ortamında güçlü ve benzersiz bir değer kullanın!
# Örnek oluşturma: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here
