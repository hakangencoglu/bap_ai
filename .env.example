# ============================================
# BAP AI - Örnek Ortam Değişkenleri (.env.example)
# ============================================
# Bu dosyayı ".env" olarak kopyalayıp kendi değerlerinizle doldurun.
# Komut: cp .env.example .env

# === Uygulama Sunucusu Yapılandırması ===
# Uygulamanın çalışacağı port numarası
PORT=8080

# === Veritabanı Sunucusu Bağlantı Bilgileri ===
# DB_HOST: PostgreSQL'in kurulu olduğu sunucunun IP adresi veya hostname
#   - Docker ortamında genellikle 'db' (compose service adı) kullanılır
#   - Yerel geliştirmede 'localhost' kullanılır
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=bap_app

# === Veritabanı Bağlantı Havuzu Ayarları ===
# Uzak veritabanı sunucusu için performans optimizasyonu
# DB_MAX_OPEN_CONNS: Aynı anda açık tutulabilecek maksimum bağlantı sayısı
DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS: Boşta bekleyen maksimum bağlantı sayısı
DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME_MIN: Bir bağlantının yaşam süresi (dakika)
DB_CONN_MAX_LIFETIME_MIN=5

# === Güvenlik ===
# JWT_SECRET: Token imzalamak için kullanılan gizli anahtar
# ÖNEMLİ: Üretim ortamında güçlü ve benzersiz bir değer kullanın!
# Örnek oluşturma: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here

# === LDAP Kimlik Doğrulama ===
# LDAP_ENABLED: LDAP giriş sisteminin aktif olup olmadığı (true/false)
LDAP_ENABLED=false
# LDAP_MOCK: Gerçek LDAP yerine simülasyon kullanılıp kullanılmayacağı (true/false)
LDAP_MOCK=true
# LDAP_HOST: LDAP sunucu adresi
LDAP_HOST=localhost
# LDAP_PORT: LDAP sunucu portu (varsayılan: 389, SSL/TLS: 636)
LDAP_PORT=389
# LDAP_BASE_DN: Arama yapılacak kök dizin
LDAP_BASE_DN=dc=izu,dc=edu,dc=tr
# LDAP_BIND_DN: Sorgulama yapabilmek için yetkili kullanıcı DN adresi
LDAP_BIND_DN=cn=admin,dc=izu,dc=edu,dc=tr
# LDAP_BIND_PASSWORD: Yetkili kullanıcı şifresi
LDAP_BIND_PASSWORD=admin_password
# LDAP_USER_FILTER: Kullanıcıları aramak için kullanılacak LDAP filtresi
LDAP_USER_FILTER=(&(objectClass=person)(mail=%s))

# === Yapay Zeka (LLM) Yapılandırması ===
# LLM_PROVIDER: Hangi yapay zeka sağlayıcısının kullanılacağı (ollama, gemini, openai_compatible, mock)
LLM_PROVIDER=mock
# LLM_ENDPOINT: Lokal veya uzak LLM sunucu adresi (Ollama için http://host.docker.internal:11434 veya http://localhost:11434, OpenAI uyumlu servisler için base URL)
LLM_ENDPOINT=http://host.docker.internal:11434
# LLM_MODEL: Kullanılacak yapay zeka model adı (Ollama için llama3, gemma2, qwen2; Gemini için gemini-1.5-flash vb.)
LLM_MODEL=llama3
# GEMINI_API_KEY: Gemini API kullanılacaksa gerekli API anahtarı
GEMINI_API_KEY=

# === E-posta (SMTP) Yapılandırması ===
# SMTP_ENABLED: E-posta gönderiminin aktif olup olmadığı (true/false).
# true olduğunda e-postalar gerçekten gönderilir, false veya boş olduğunda terminal loguna mock olarak yazdırılır.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

